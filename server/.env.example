# Copia este archivo como .env y cambia estos valores antes de publicar.
PORT=4000
# En este entorno de edición deja HOST=127.0.0.1 (no lo cambies aquí).
# Al desplegar en un servicio real (Render, Railway, Fly.io, etc.) usa HOST=0.0.0.0
HOST=127.0.0.1
ADMIN_PASSWORD=cambia-esta-contrasena
JWT_SECRET=cambia-este-secreto-largo-y-aleatorio
# Dominio real del sitio publicado, ej: https://tuartista.com
# Déjalo en * mientras pruebas, pero fíjalo al dominio real antes de producción.
CORS_ORIGIN=*
